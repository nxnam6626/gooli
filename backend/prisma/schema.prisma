// ============================================================
// Gooli.vn - Prisma Schema (Prisma v6 + PostgreSQL)
// Tối ưu hóa Free Tier: Int PK, VarChar, Timestamptz(3)
// ============================================================

datasource db {
provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// CATEGORY - Danh mục sản phẩm
// Int PK (4 bytes) vs UUID (16 bytes) → tiết kiệm ~60% dung lượng index
// ============================================================
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  products  Product[]
}

// ============================================================
// PRODUCT - Sản phẩm (trần nhôm, linh kiện, ...)
// Chỉ lưu imageUrl (URL từ Cloudinary), không lưu binary/base64
// ============================================================
model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  sku         String   @unique @db.VarChar(50) @default("")
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(180)
  pricePerM2  Decimal  @db.Decimal(12, 2) // Tránh Float để không mất độ chính xác tiền tệ
  imageUrl    String   @db.VarChar(255)   // URL Cloudinary - tiết kiệm so với lưu binary
  description String?  @db.Text
  thickness   Decimal? @db.Decimal(5, 2)  // Độ dày (mm)
  width       Decimal? @db.Decimal(10, 2) // Chiều rộng (mm)
  length      Decimal? @db.Decimal(10, 2) // Chiều dài (mm)
  unit        String   @db.VarChar(20)   @default("tấm") // m², tấm, cây, bộ...
  isActive    Boolean  @default(true)
  minQuantity Int      @default(0)        // Ngưỡng cảnh báo tồn kho tối thiểu
  itemClassId    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  category       Category               @relation(fields: [categoryId], references: [id])
  itemClass      ItemClass?             @relation(fields: [itemClassId], references: [id])
  stock          Stock?
  receiptItems   ReceiptItem[]
  exportItems    ExportItem[]

  @@index([slug])       // Dùng cho page sản phẩm chi tiết theo slug
  @@index([categoryId]) // Dùng cho lọc theo danh mục
}

// ============================================================
// STOCK - Tồn kho (quan hệ 1-1 với Product)
// Dùng productId làm PK để loại bỏ cột id thừa, tiết kiệm bộ nhớ
// Cột quantity: số lượng đạt tiêu chuẩn (sellable)
// Cột faultyQty: số lượng hàng hỏng (faulty)
// ============================================================
model Stock {
  productId Int      @id
  quantity  Int      @default(0)
  faultyQty Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================================
// PARTNER - Đối tác (Nhà cung cấp / Khách hàng / Đại lý)
// ============================================================
enum PartnerType {
  SUPPLIER
  CUSTOMER
}

model Partner {
  id             Int          @id @default(autoincrement())
  code           String       @unique @db.VarChar(50) // VD: NCC-001, KH-002
  name           String       @db.VarChar(150)
  type           PartnerType
  partnerGroupId Int?
  phone          String?      @db.VarChar(20)
  email          String?      @db.VarChar(100)
  address        String?      @db.VarChar(255)
  taxCode        String?      @db.VarChar(50)
  totalDebt      Decimal      @db.Decimal(12, 2) @default(0)
  discountRate   Decimal?     @db.Decimal(5, 2)
  note           String?      @db.VarChar(500)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  partnerGroup    PartnerGroup?    @relation(fields: [partnerGroupId], references: [id])
  receipts        Receipt[]
  exports         Export[]
  slips           PaymentSlip[]
}

// ============================================================
// Enum trạng thái phiếu kho
// ============================================================
enum TransactionStatus {
  PENDING   // Chờ duyệt
  APPROVED  // Đã duyệt - đã cập nhật tồn kho
  REJECTED  // Từ chối
}

// ============================================================
// RECEIPT - Phiếu nhập kho
// ============================================================
model Receipt {
  id                   Int               @id @default(autoincrement())
  code                 String            @unique @db.VarChar(50) // VD: NK-20260527-001
  status               TransactionStatus @default(PENDING)
  createdById          Int
  approvedById         Int?
  partnerId            Int?
  invoiceNumber        String?           @db.VarChar(50)
  invoiceDate          DateTime?         @db.Timestamptz(3)
  preTaxTotal          Decimal           @db.Decimal(12, 2) @default(0)
  postTaxTotal         Decimal           @db.Decimal(12, 2) @default(0)
  paidAmount           Decimal           @db.Decimal(12, 2) @default(0) // Số tiền đã trả cho phiếu nhập
  paymentStatus        PaymentStatus     @default(UNPAID)
  note                 String?           @db.VarChar(500)
  expectedDeliveryDate DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  approvedAt           DateTime?         @db.Timestamptz(3)

  partner         Partner?         @relation(fields: [partnerId], references: [id])
  items           ReceiptItem[]
  slips           PaymentSlip[]

  @@index([status])    // Lọc phiếu theo trạng thái nhanh
  @@index([createdAt]) // Sắp xếp theo ngày tháng
}

// ============================================================
// RECEIPT ITEM - Chi tiết phiếu nhập kho
// ============================================================
model ReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int
  productId Int
  isFaulty            Boolean @default(false)
  quantity            Int
  price               Decimal @db.Decimal(12, 2) // Giá nhập tại thời điểm đó (lịch sử)
  supplierProductName String? @db.VarChar(150)
  vatRate             Decimal @db.Decimal(5, 2) @default(10.00) // Thuế suất VAT (8% hoặc 10%)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([receiptId, productId]) // Mỗi sản phẩm chỉ xuất hiện 1 lần trong 1 phiếu
}

// ============================================================
// EXPORT - Phiếu xuất kho
// ============================================================
model Export {
  id           Int               @id @default(autoincrement())
  code         String            @unique @db.VarChar(50) // VD: XK-20260527-001
  status       TransactionStatus @default(PENDING)
  createdById  Int
  approvedById Int?
  partnerId    Int?
  note         String?           @db.VarChar(500)
  preTaxTotal  Decimal           @db.Decimal(12, 2) @default(0)
  postTaxTotal Decimal           @db.Decimal(12, 2) @default(0)
  paidAmount   Decimal           @db.Decimal(12, 2) @default(0) // Số tiền đã thu cho phiếu xuất
  paymentStatus PaymentStatus    @default(UNPAID)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  approvedAt   DateTime?         @db.Timestamptz(3)

  partner         Partner?         @relation(fields: [partnerId], references: [id])
  items           ExportItem[]
  slips           PaymentSlip[]

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// EXPORT ITEM - Chi tiết phiếu xuất kho
// ============================================================
model ExportItem {
  id        Int     @id @default(autoincrement())
  exportId  Int
  productId Int
  isFaulty  Boolean @default(false)
  quantity  Int
  price     Decimal @db.Decimal(12, 2) @default(0)
  vatRate   Decimal @db.Decimal(5, 2) @default(10.00)

  export Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([exportId, productId])
}

// ============================================================
// USER - Tài khoản thủ kho / admin nội bộ
// ============================================================
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(150)
  passwordHash String   @db.VarChar(255) // bcrypt hash - không lưu plain text
  name         String   @db.VarChar(100)
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  slips           PaymentSlip[]
}

enum UserRole {
  ADMIN // Duyệt phiếu, quản lý sản phẩm
  STAFF // Tạo phiếu nhập/xuất
}


// ============================================================
// NEW TABLES FOR FINANCIALS, RETURNS, AND EXTENDED CATEGORIES
// ============================================================

enum PaymentStatus {
  UNPAID         // Chưa thanh toán
  PARTIALLY_PAID // Thanh toán một phần
  PAID           // Đã thanh toán
}

enum SlipType {
  RECEIPT // Phiếu thu (Thu tiền khách hàng -> Giảm nợ khách hàng)
  PAYMENT // Phiếu chi (Chi tiền cho NCC -> Giảm nợ NCC)
}

model Unit {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
}

model ItemClass {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  products  Product[]
}


// ============================================================
// PARTNER GROUP - Nhóm đối tác
// ============================================================
model PartnerGroup {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  policy      String?   @db.VarChar(150)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  partners    Partner[]
}

// Bảng Phiếu thu / Phiếu chi
model PaymentSlip {
  id            Int           @id @default(autoincrement())
  code          String        @unique // VD: PT-20260612-001, PC-20260612-001
  type          SlipType
  partnerId     Int
  receiptId     Int?          // Liên kết đích danh phiếu nhập (nếu có)
  exportId      Int?          // Liên kết đích danh phiếu xuất (nếu có)
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod String        @db.VarChar(50) // Tiền mặt, Chuyển khoản
  note          String?       @db.VarChar(255)
  createdById   Int
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  partner       Partner       @relation(fields: [partnerId], references: [id])
  receipt       Receipt?      @relation(fields: [receiptId], references: [id])
  export        Export?       @relation(fields: [exportId], references: [id])
  createdByUser User          @relation(fields: [createdById], references: [id])
}

model SystemSetting {
  key   String @id @db.VarChar(100)
  value String @db.Text
}

model PublicCategory {
  id            Int              @id @default(autoincrement())
  label         String           @db.VarChar(100)
  href          String           @db.VarChar(200)
  icon          String           @db.VarChar(50) @default("Stack")
  parentId      Int?
  order         Int              @default(0)
  parent        PublicCategory?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories PublicCategory[] @relation("SubCategories")
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
}

