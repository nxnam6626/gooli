# Backend NestJS - Gooli.vn

# ===== DATABASE =====
# Supabase / Neon connection (Transaction Pooler URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gooli?pgbouncer=true&connection_limit=1"
# Direct URL for migrations (không qua pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/gooli"

# ===== APP =====
PORT=3001
NODE_ENV=development

# ===== JWT AUTH =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ===== CORS =====
# Frontend URLs được phép gọi API
FRONTEND_URL=http://localhost:3000

# ===== NEXT.JS REVALIDATION WEBHOOK =====
# Secret token để xác thực webhook từ backend sang Next.js
REVALIDATION_SECRET=your-revalidation-secret-key
NEXTJS_URL=http://localhost:3000
